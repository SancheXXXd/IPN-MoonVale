{
  "schemaVersion": 1,
  "id": "inventoryprofilesnext",
  "version": "${version}",
  "name": "Inventory Profiles Next (MoonVale)",
  "description": "Inventory sorting and manual slot locking for MoonVale without automatic refilling, trading or crafting.",
  "authors": [
    "SancheXXXd_",
    "Omeleox"
  ],
  "contributors": [
    "Mirinimi / Plamen K. Kosseff (original Inventory Profiles Next)",
    "jsnimda (original Inventory Profiles)"
  ],
  "contact": {
    "homepage": "https://github.com/SancheXXXd/IPN-MoonVale",
    "sources": "https://github.com/SancheXXXd/IPN-MoonVale"
  },
  "license": "AGPL-3.0-or-later",
  "icon": "assets/inventoryprofilesnext/mod-icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.anti_ad.mc.ipnext.InventoryProfilesKt::init"
    ],
    "modmenu": [
      "org.anti_ad.mc.ipnext.compat.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "mixins.ipnext.json"
  ],
  "accessWidener": "inventoryprofilesnext.accesswidener",
  "depends": {
    "minecraft": ">=26.3 <26.4",
    "libipn": ">=6.9.0 <6.10",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "moonvale.link.website": "https://moonvale.ru/",
        "moonvale.link.source": "https://github.com/SancheXXXd/IPN-MoonVale",
        "moonvale.link.upstream": "https://codeberg.org/Inventory-Profiles-Next-Mod/IPN"
      }
    }
  }
}
